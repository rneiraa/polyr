#!/bin/sh
# Revisa que no se publiquen secretos ni datos personales antes de empujar.
# Se activa una sola vez con:  git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
if command -v uv >/dev/null 2>&1; then
    uv run python scripts/revisar_secretos.py --historial || exit 1
else
    python3 scripts/revisar_secretos.py --historial || exit 1
fi
